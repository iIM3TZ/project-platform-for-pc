PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pc_parts
DB_USER=postgres
DB_PASSWORD=your_password_here

# Signs the sign-in token (JWT). A long random text, at least 32 characters; keep it secret.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_text
